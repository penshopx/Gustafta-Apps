    "check:legacy-memory-tests": "tsc -p tests/legacy-memory.tsconfig.json",
    "test:kb-context-http": "bash scripts/test-kb-context-http.sh",
    "test:kb-publication-concurrency": "bash scripts/test-kb-publication-concurrency.sh",
