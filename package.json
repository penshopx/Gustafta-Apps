    "visual:update": "node scripts/check-visual.mjs --update",
    "visual:setup": "bash scripts/setup-visual-env.sh",
    "visual:ci": "node scripts/run-visual-ci.mjs",
    "test:visual-ci": "node --test tests/visual-ci.test.mjs",
    "test:visual-ci-failures": "node --test tests/visual-ci-failures.test.mjs",
    "test:visual-negative": "node --test --test-concurrency=1 tests/visual-negative.test.mjs tests/visual-application-ring.test.mjs"
